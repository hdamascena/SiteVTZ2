rules_version = '2';

// Associação Esportiva Vitalizar - Firestore Security Rules (Vitrine Institucional + LGPD)
service cloud.firestore {
  match /databases/{database}/documents {

    function isPrimarySuperAdmin() {
      return request.auth != null
        && request.auth.token.email == 'higor.rock2011@gmail.com';
    }

    function adminDocExists() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function role() {
      return isPrimarySuperAdmin()
        ? 'super_admin'
        : (adminDocExists() ? adminData().role : 'none');
    }

    function isActive() {
      return isPrimarySuperAdmin()
        || (adminDocExists() && adminData().ativo == true);
    }

    function hasRole(roles) {
      return isActive() && (role() in roles);
    }

    function nonEmptyStr(val, max) {
      return val is string && val.size() > 0 && val.size() <= max;
    }

    function optStr(data, field, max) {
      return !(field in data) || data[field] == null
        || (data[field] is string && data[field].size() <= max);
    }

    function validClubInfo() {
      let d = request.resource.data;
      return nonEmptyStr(d.name, 200)
        && nonEmptyStr(d.shortName, 80)
        && nonEmptyStr(d.cnpj, 30)
        && nonEmptyStr(d.email, 200)
        && d.phones is list && d.phones.size() <= 10;
    }

    function validSiteSettings() {
      let d = request.resource.data;
      return nonEmptyStr(d.seoTitle, 200)
        && nonEmptyStr(d.seoDescription, 1000)
        && nonEmptyStr(d.whatsappNumber, 40)
        && d.enableRegistrations is bool
        && d.enableSponsorsSection is bool
        && d.enableFloatingWhatsapp is bool
        && d.enableSearch is bool
        && d.enableRsvpModal is bool
        && !('donationPledges' in d)
        && !('attendanceSessions' in d);
    }

    function validNewsArticle(docId) {
      let d = request.resource.data;
      return d.id == docId
        && nonEmptyStr(d.title, 300)
        && nonEmptyStr(d.date, 60)
        && nonEmptyStr(d.category, 100)
        && nonEmptyStr(d.summary, 2000)
        && d.content is list && d.content.size() <= 200
        && optStr(d, 'imageUrl', 900000)
        && optStr(d, 'author', 120)
        && optStr(d, 'status', 40);
    }

    function validSponsor(docId) {
      let d = request.resource.data;
      return d.id == docId
        && nonEmptyStr(d.name, 200)
        && d.tier in ['master', 'ouro', 'prata', 'bronze', 'apoio']
        && nonEmptyStr(d.tierLabel, 100)
        && nonEmptyStr(d.logoUrl, 900000)
        && optStr(d, 'websiteUrl', 2000)
        && optStr(d, 'description', 2000)
        && nonEmptyStr(d.category, 100)
        && d.active is bool
        && d.order is number;
    }

    function validEvent(docId) {
      let d = request.resource.data;
      return d.id == docId
        && nonEmptyStr(d.title, 300)
        && d.category in ['clinica_esportiva', 'oficina_comunitaria', 'reuniao_associacao']
        && nonEmptyStr(d.date, 40)
        && nonEmptyStr(d.time, 80)
        && nonEmptyStr(d.location, 300)
        && d.capacity is number && d.capacity >= 0 && d.capacity <= 100000
        && d.availableSpots is number && d.availableSpots >= 0 && d.availableSpots <= d.capacity
        && d.isFree is bool
        && nonEmptyStr(d.description, 5000)
        && d.status in ['confirmado', 'inscricoes_abertas', 'vagas_limitadas', 'em_breve'];
    }

    function validProject(docId) {
      let d = request.resource.data;
      return d.id == docId
        && nonEmptyStr(d.name, 200)
        && nonEmptyStr(d.category, 100)
        && nonEmptyStr(d.targetAudience, 300)
        && nonEmptyStr(d.description, 5000)
        && nonEmptyStr(d.schedule, 300)
        && nonEmptyStr(d.location, 300)
        && nonEmptyStr(d.coordinator, 200)
        && nonEmptyStr(d.fundingSource, 300)
        && optStr(d, 'imageUrl', 900000)
        && (!('participants' in d) || (d.participants is list && d.participants.size() <= 500));
    }

    function validGalleryAlbum(docId) {
      let d = request.resource.data;
      return d.id == docId
        && nonEmptyStr(d.title, 300)
        && nonEmptyStr(d.category, 100)
        && nonEmptyStr(d.date, 80)
        && nonEmptyStr(d.location, 300)
        && nonEmptyStr(d.coverUrl, 900000)
        && optStr(d, 'caption', 1000)
        && d.albumPhotos is list && d.albumPhotos.size() <= 200;
    }

    function validTransparencyDoc(docId) {
      let d = request.resource.data;
      return d.id == docId
        && nonEmptyStr(d.title, 300)
        && d.category in ['estatuto', 'cnpj', 'governanca', 'emendas', 'fomento', 'prestacao_contas', 'certidoes']
        && nonEmptyStr(d.date, 80)
        && nonEmptyStr(d.description, 4000)
        && nonEmptyStr(d.fileType, 80)
        && nonEmptyStr(d.badge, 120)
        && optStr(d, 'downloadUrl', 900000)
        && optStr(d, 'fileDataUrl', 900000);
    }

    function validFacilityPolo(docId) {
      let d = request.resource.data;
      return d.id == docId
        && nonEmptyStr(d.name, 200)
        && d.type in ['polo_principal', 'quadra_poliesportiva', 'sala_atividades', 'espaco_saude']
        && nonEmptyStr(d.capacity, 200)
        && d.maxGuests is number && d.maxGuests > 0 && d.maxGuests <= 100000
        && nonEmptyStr(d.address, 300)
        && nonEmptyStr(d.description, 3000)
        && optStr(d, 'imageUrl', 900000)
        && d.includedItems is list && d.includedItems.size() <= 100
        && d.rules is list && d.rules.size() <= 100;
    }

    function validRsvp(docId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'eventId', 'eventTitle', 'name', 'phone', 'email', 'notes',
          'spots', 'date', 'confirmationCode', 'projectId', 'enrollmentStatus',
          'studentName', 'studentAge', 'responsibleName', 'modalityOrClass', 'userId',
          'teamId', 'modality'
        ])
        && d.id == docId
        && nonEmptyStr(d.eventId, 120)
        && nonEmptyStr(d.eventTitle, 300)
        && nonEmptyStr(d.name, 240)
        && nonEmptyStr(d.phone, 40)
        && optStr(d, 'email', 200)
        && optStr(d, 'notes', 1000)
        && optStr(d, 'projectId', 120)
        && optStr(d, 'enrollmentStatus', 40)
        && optStr(d, 'studentName', 200)
        && optStr(d, 'responsibleName', 200)
        && optStr(d, 'modalityOrClass', 120)
        && optStr(d, 'userId', 128)
        && optStr(d, 'teamId', 120)
        && optStr(d, 'modality', 120)
        && d.spots is int && d.spots >= 1 && d.spots <= 10
        && nonEmptyStr(d.date, 60)
        && nonEmptyStr(d.confirmationCode, 40);
    }

    function validContactMessage(docId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'name', 'email', 'phone', 'subject', 'message', 'date', 'read'])
        && d.id == docId
        && nonEmptyStr(d.name, 120)
        && nonEmptyStr(d.email, 200)
        && nonEmptyStr(d.phone, 40)
        && nonEmptyStr(d.subject, 120)
        && nonEmptyStr(d.message, 4000)
        && nonEmptyStr(d.date, 60)
        && d.read is bool;
    }

    function validScoutInquiry(docId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'protocol', 'scoutName', 'organization', 'role', 'credentialsId',
          'phone', 'email', 'inquiryType', 'targetPlayerName', 'targetCategory',
          'preferredDate', 'message', 'projectName', 'createdAt', 'status'
        ])
        && d.id == docId
        && nonEmptyStr(d.protocol, 40)
        && nonEmptyStr(d.scoutName, 120)
        && nonEmptyStr(d.organization, 200)
        && nonEmptyStr(d.role, 120)
        && optStr(d, 'credentialsId', 80)
        && nonEmptyStr(d.phone, 40)
        && nonEmptyStr(d.email, 200)
        && d.inquiryType in ['avaliacao_clube', 'visita_treino', 'relatorio_atleta', 'parceria_base']
        && optStr(d, 'targetPlayerName', 160)
        && nonEmptyStr(d.targetCategory, 80)
        && optStr(d, 'preferredDate', 40)
        && nonEmptyStr(d.message, 4000)
        && nonEmptyStr(d.projectName, 200)
        && nonEmptyStr(d.createdAt, 60)
        && d.status in ['nova', 'em_analise', 'agendada', 'concluida'];
    }

    function validDonationPledge(docId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'protocol', 'donorName', 'donorEmail', 'userId',
          'amount', 'purpose', 'date', 'message', 'status'
        ])
        && d.id == docId
        && nonEmptyStr(d.protocol, 40)
        && nonEmptyStr(d.donorName, 120)
        && optStr(d, 'donorEmail', 200)
        && optStr(d, 'userId', 128)
        && d.amount is number && d.amount > 0 && d.amount <= 1000000
        && nonEmptyStr(d.purpose, 200)
        && nonEmptyStr(d.date, 60)
        && optStr(d, 'message', 500)
        && d.status in ['registrado', 'confirmado'];
    }

    function validVolunteerApplication(docId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'protocol', 'name', 'area', 'availability',
          'experience', 'contactInfo', 'motivation', 'createdAt', 'status'
        ])
        && d.id == docId
        && nonEmptyStr(d.protocol, 40)
        && nonEmptyStr(d.name, 120)
        && d.area in [
          'Educação Física & Esporte',
          'Saúde, Fisio & Nutrição',
          'Psicologia & Serviço Social',
          'Comunicação, Foto & Mídia',
          'Apoio em Eventos & Logística',
          'Mentoria & Educação'
        ]
        && nonEmptyStr(d.availability, 120)
        && nonEmptyStr(d.experience, 2000)
        && nonEmptyStr(d.contactInfo, 200)
        && nonEmptyStr(d.motivation, 2000)
        && nonEmptyStr(d.createdAt, 60)
        && d.status in ['novo', 'em_analise', 'ativo'];
    }

    function validAdminProfile() {
      let d = request.resource.data;
      return nonEmptyStr(d.email, 200)
        && nonEmptyStr(d.nome, 150)
        && d.role in [
          'super_admin', 'admin', 'editor', 'financeiro', 'parceiro'
        ]
        && d.projectIds is list && d.projectIds.size() <= 50
        && d.ativo is bool
        && nonEmptyStr(d.criadoEm, 60)
        && nonEmptyStr(d.criadoPor, 200);
    }

    function validInviteMatches(email) {
      return exists(/databases/$(database)/documents/admin_invites/$(email))
        && request.resource.data.role == get(/databases/$(database)/documents/admin_invites/$(email)).data.role
        && request.resource.data.projectIds == get(/databases/$(database)/documents/admin_invites/$(email)).data.projectIds
        && request.resource.data.ativo == true;
    }

    function validAuditLog(docId) {
      let d = request.resource.data;
      return d.id == docId
        && nonEmptyStr(d.action, 120)
        && nonEmptyStr(d.adminEmail, 200)
        && nonEmptyStr(d.timestamp, 60)
        && optStr(d, 'role', 60)
        && optStr(d, 'collection', 100)
        && optStr(d, 'itemId', 120)
        && optStr(d, 'beforeSummary', 2000)
        && optStr(d, 'afterSummary', 2000)
        && optStr(d, 'details', 2000);
    }

    // 1. Perfis de Acesso (/admins/{uid}) e Convites (/admin_invites/{email})
    match /admins/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid)
        || hasRole(['super_admin', 'admin', 'financeiro']);

      allow create: if validAdminProfile() && (
        hasRole(['super_admin'])
        || (hasRole(['admin']) && request.resource.data.role != 'super_admin')
        || (
          request.auth != null
          && request.auth.uid == uid
          && request.auth.token.email == request.resource.data.email
          && (
            (isPrimarySuperAdmin() && request.resource.data.role == 'super_admin' && request.resource.data.ativo == true)
            || (request.auth.token.email_verified == true && validInviteMatches(request.auth.token.email))
          )
        )
      );

      allow update: if validAdminProfile() && (
        hasRole(['super_admin'])
        || (
          hasRole(['admin'])
          && resource.data.role != 'super_admin'
          && request.resource.data.role != 'super_admin'
        )
      );

      allow delete: if hasRole(['super_admin']);
    }

    match /admin_invites/{email} {
      allow read: if hasRole(['super_admin', 'admin'])
        || (request.auth != null && request.auth.token.email == email);
      allow create, update: if hasRole(['super_admin'])
        || (hasRole(['admin']) && request.resource.data.role != 'super_admin');
      allow delete: if hasRole(['super_admin', 'admin'])
        || (request.auth != null && request.auth.token.email == email);
    }

    // 2. Coleções Públicas da Vitrine
    match /club_info/{docId} {
      allow read: if true;
      allow create, update: if hasRole(['super_admin', 'admin', 'editor']) && validClubInfo();
      allow delete: if hasRole(['super_admin', 'admin']);
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow create, update: if hasRole(['super_admin', 'admin', 'editor', 'financeiro']) && validSiteSettings();
      allow delete: if hasRole(['super_admin', 'admin']);
    }

    match /news_articles/{docId} {
      allow read: if true;
      allow create, update: if hasRole(['super_admin', 'admin', 'editor']) && validNewsArticle(docId);
      allow delete: if hasRole(['super_admin', 'admin', 'editor']);
    }

    match /sponsors/{docId} {
      allow read: if true;
      allow create, update: if hasRole(['super_admin', 'admin', 'editor', 'parceiro']) && validSponsor(docId);
      allow delete: if hasRole(['super_admin', 'admin', 'editor']);
    }

    match /events/{docId} {
      allow read: if true;
      allow create, update: if hasRole(['super_admin', 'admin', 'editor']) && validEvent(docId);
      allow delete: if hasRole(['super_admin', 'admin', 'editor']);
    }

    match /projects/{docId} {
      allow read: if true;
      allow create, update: if hasRole(['super_admin', 'admin', 'editor']) && validProject(docId);
      allow delete: if hasRole(['super_admin', 'admin']);
    }

    match /gallery_albums/{docId} {
      allow read: if true;
      allow create, update, delete: if hasRole(['super_admin', 'admin', 'editor']) && (request.method == 'delete' || validGalleryAlbum(docId));
    }

    match /transparency_docs/{docId} {
      allow read: if true;
      allow create, update: if hasRole(['super_admin', 'admin', 'financeiro']) && validTransparencyDoc(docId);
      allow delete: if hasRole(['super_admin', 'admin']);
    }

    match /facility_polos/{docId} {
      allow read: if true;
      allow create, update: if hasRole(['super_admin', 'admin', 'editor']) && validFacilityPolo(docId);
      allow delete: if hasRole(['super_admin', 'admin']);
    }

    // 3. Captação de Interesses e Comunidade
    match /rsvps/{docId} {
      allow create: if validRsvp(docId);
      allow read: if hasRole(['super_admin', 'admin']);
      allow update: if hasRole(['super_admin', 'admin']) && validRsvp(docId);
      allow delete: if hasRole(['super_admin', 'admin']);
    }

    match /contact_messages/{docId} {
      allow create: if validContactMessage(docId);
      allow read, delete: if hasRole(['super_admin', 'admin']);
      allow update: if hasRole(['super_admin', 'admin']) && validContactMessage(docId);
    }

    match /scout_inquiries/{docId} {
      allow create: if validScoutInquiry(docId);
      allow read: if hasRole(['super_admin', 'admin', 'parceiro']);
      allow update: if hasRole(['super_admin', 'admin']) && validScoutInquiry(docId);
      allow delete: if hasRole(['super_admin', 'admin']);
    }

    match /donation_pledges/{docId} {
      allow create: if validDonationPledge(docId);
      allow read: if hasRole(['super_admin', 'admin', 'financeiro']);
      allow update: if hasRole(['super_admin', 'admin', 'financeiro']) && validDonationPledge(docId);
      allow delete: if hasRole(['super_admin', 'admin']);
    }

    match /volunteer_applications/{docId} {
      allow create: if validVolunteerApplication(docId);
      allow read, delete: if hasRole(['super_admin', 'admin']);
      allow update: if hasRole(['super_admin', 'admin']) && validVolunteerApplication(docId);
    }

    match /audit_logs/{docId} {
      allow create: if isActive() && validAuditLog(docId);
      allow read: if hasRole(['super_admin', 'admin']);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
